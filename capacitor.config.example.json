{
  "appId": "com.agninisanfe.app",
  "appName": "Agnini Sanfè",
  "webDir": "dist",
  "backgroundColor": "#201D19",
  "android": {
    "backgroundColor": "#201D19"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": false,
      "backgroundColor": "#201D19",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#201D19"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SystemBars": {
      "style": "DARK"
    }
  }
}
